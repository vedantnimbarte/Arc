{
  "name": "arc",
  "private": true,
  "version": "0.17.0",
  "description": "ARC — terminal, editor & git workspace with optional Wingman agents",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @arc/frontend dev",
    "build": "pnpm -r build",
    "tauri": "pnpm --filter @arc/desktop tauri",
    "tauri:dev": "pnpm --filter @arc/desktop tauri:dev",
    "tauri:build": "pnpm --filter @arc/desktop tauri:build",
    "e2e": "pnpm --filter @arc/e2e e2e",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "pnpm -r --parallel exec rimraf dist node_modules .turbo && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "pnpm": {
    "overrides": {
      "undici@>=6 <6.29.1": "^6.29.1",
      "undici@>=7 <7.30.1": "^7.30.1",
      "basic-ftp@<6.2.1": "^6.2.1",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "ip-address@<10.7.4": "^10.7.4",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
