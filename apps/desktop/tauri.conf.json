{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARC",
  "version": "0.1.0",
  "identifier": "dev.arc.terminal",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @arc/frontend dev",
    "beforeBuildCommand": "pnpm --filter @arc/frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-native terminal & agent runtime",
    "longDescription": "ARC is an AI-native terminal that combines high-performance shell I/O with agent orchestration and an embedded code editor."
  }
}
